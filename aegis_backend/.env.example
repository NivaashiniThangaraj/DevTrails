# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────
# Create a free DB at supabase.com or neon.tech, then paste the URL here
DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=30d

# ── OpenWeatherMap ────────────────────────────────────────────────
OWM_API_KEY=your_openweathermap_api_key

# ── Razorpay (test mode) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ── OTP (in test mode we just return OTP in response) ─────────────
# Set to 'true' in production to use a real SMS provider (Twilio/MSG91)
USE_REAL_SMS=false
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
